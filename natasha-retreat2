<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ריטריט · 24 סגנונות עיצוב</title>
<style>
:root{
  --cream:#FAF6F0; --sand:#EFE6D8; --terra:#C4754E; --terra-d:#9C5535;
  --sage:#8FA08A; --sage-d:#5F7059; --rose:#E8C4B8; --rose-d:#C99386;
  --ink:#3B312A; --ink-soft:#6B5F54; --gold:#C9A06B; --night:#2B221C;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:"Segoe UI","Heebo","Arial Hebrew",Arial,sans-serif;color:var(--ink);background:#fff}
.serif{font-family:Georgia,"Times New Roman","Frank Ruehl CLM",serif}
img,svg{display:block;max-width:100%}
a{color:inherit;text-decoration:none}

/* ===== top index ===== */
.index{position:sticky;top:0;z-index:50;background:rgba(250,246,240,.92);backdrop-filter:blur(8px);border-bottom:1px solid #E5DACB;padding:10px 20px;display:flex;gap:6px;overflow-x:auto;scrollbar-width:thin}
.index a{flex:0 0 auto;font-size:12px;padding:5px 11px;border-radius:99px;border:1px solid #DCCFBC;color:var(--ink-soft);white-space:nowrap;transition:.2s}
.index a:hover{background:var(--terra);border-color:var(--terra);color:#fff}

/* ===== slide frame ===== */
.slide{position:relative;min-height:100vh;display:flex;align-items:center;justify-content:center;overflow:hidden;padding:72px 24px}
.tag{position:absolute;top:18px;right:20px;z-index:9;font-size:11.5px;letter-spacing:.12em;background:var(--ink);color:#fff;padding:6px 14px;border-radius:99px;opacity:.85}
.btn{display:inline-block;padding:13px 34px;border-radius:99px;font-size:15px;cursor:pointer;border:none;transition:.25s}
.btn:hover{transform:translateY(-2px)}
.eyebrow{font-size:13px;letter-spacing:.28em;text-transform:uppercase}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}

/* ===== 01 minimal centered ===== */
.s1{background:var(--cream);text-align:center;flex-direction:column}
.s1 .eyebrow{color:var(--terra);margin-bottom:22px}
.s1 h1{font-size:clamp(40px,7vw,84px);font-weight:300;line-height:1.15;letter-spacing:-.01em;max-width:14ch;margin:0 auto 18px}
.s1 p{color:var(--ink-soft);font-size:18px;max-width:42ch;margin:0 auto 34px;line-height:1.8}
.s1 .arch{width:min(340px,70vw);height:230px;border-radius:170px 170px 14px 14px;overflow:hidden;margin:40px auto 0;box-shadow:0 24px 50px -28px rgba(120,80,50,.45)}
.s1 .btn{background:var(--ink);color:var(--cream)}

/* ===== 02 classic split ===== */
.s2{background:#fff;padding:0}
.s2 .wrap{display:grid;grid-template-columns:1fr 1fr;width:100%;min-height:100vh}
.s2 .txt{display:flex;flex-direction:column;justify-content:center;padding:80px 7vw;background:var(--sand)}
.s2 .eyebrow{color:var(--terra-d);margin-bottom:18px}
.s2 h1{font-size:clamp(36px,4.6vw,62px);line-height:1.2;font-weight:600;margin-bottom:20px}
.s2 p{color:var(--ink-soft);line-height:1.85;margin-bottom:32px;font-size:17px}
.s2 .btn{background:var(--terra);color:#fff;align-self:flex-start}
.s2 .img{min-height:50vh}
.s2 .img svg{width:100%;height:100%}
@media(max-width:820px){.s2 .wrap{grid-template-columns:1fr}}

/* ===== 03 arch hero ===== */
.s3{background:linear-gradient(180deg,#F6EFE5,#F0E2D2);flex-direction:column;text-align:center}
.s3 .archbig{position:relative;width:min(520px,86vw);height:min(580px,72vh);border-radius:300px 300px 0 0;overflow:hidden;box-shadow:0 40px 80px -40px rgba(110,70,40,.5)}
.s3 .archbig svg{width:100%;height:100%}
.s3 .over{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;padding-bottom:54px;background:linear-gradient(180deg,transparent 40%,rgba(43,34,28,.55));color:#FFF8EF}
.s3 h1{font-size:clamp(34px,5vw,56px);font-weight:300;margin-bottom:10px}
.s3 .over p{font-size:16px;opacity:.92;margin-bottom:22px}
.s3 .btn{background:#FFF8EF;color:var(--ink)}

/* ===== 04 editorial overlap ===== */
.s4{background:var(--cream)}
.s4 .wrap{position:relative;width:min(1080px,94vw)}
.s4 .photo{width:62%;height:62vh;min-height:380px;margin-right:auto;border-radius:6px;overflow:hidden}
.s4 .photo svg{width:100%;height:100%}
.s4 h1{position:absolute;top:50%;right:0;transform:translateY(-50%);font-size:clamp(52px,9vw,128px);font-weight:700;line-height:.95;color:var(--ink);mix-blend-mode:multiply;letter-spacing:-.02em}
.s4 h1 em{font-style:normal;color:var(--terra)}
.s4 .meta{position:absolute;bottom:-8px;left:0;background:#fff;padding:22px 28px;border-radius:6px;box-shadow:0 18px 40px -24px rgba(0,0,0,.25);max-width:300px}
.s4 .meta p{font-size:14.5px;color:var(--ink-soft);line-height:1.7;margin-bottom:12px}
.s4 .btn{background:var(--ink);color:#fff;padding:10px 24px;font-size:13.5px}
@media(max-width:760px){.s4 .photo{width:100%}.s4 h1{position:static;transform:none;margin:18px 0}.s4 .meta{position:static;margin-top:14px}}

/* ===== 05 warm dark ===== */
.s5{background:var(--night);color:#F4E8D8;text-align:center;flex-direction:column}
.s5 .sun{width:180px;height:180px;border-radius:50%;background:radial-gradient(circle at 50% 40%,#FFD9A0,#E0925A 60%,#B86038);box-shadow:0 0 90px 30px rgba(224,146,90,.35);margin-bottom:44px}
.s5 .eyebrow{color:var(--gold);margin-bottom:16px}
.s5 h1{font-size:clamp(38px,6vw,72px);font-weight:300;line-height:1.25;margin-bottom:18px}
.s5 p{color:#C9B49B;max-width:46ch;line-height:1.9;margin:0 auto 36px}
.s5 .btn{background:transparent;color:#F4E8D8;border:1px solid #8A6F55}
.s5 .btn:hover{background:#F4E8D8;color:var(--night)}

/* ===== 06 polaroid ===== */
.s6{background:#F3EDE3}
.s6 .wrap{display:flex;align-items:center;gap:6vw;width:min(1100px,94vw);flex-wrap:wrap;justify-content:center}
.s6 .pols{position:relative;width:380px;height:420px;flex:0 0 auto}
.s6 .pol{position:absolute;background:#fff;padding:12px 12px 44px;box-shadow:0 16px 38px -18px rgba(0,0,0,.35);width:240px}
.s6 .pol svg{width:100%;height:200px}
.s6 .pol span{display:block;text-align:center;margin-top:10px;font-size:13px;color:var(--ink-soft)}
.s6 .p1{top:0;right:0;transform:rotate(6deg)}
.s6 .p2{top:90px;right:130px;transform:rotate(-7deg)}
.s6 .txt{max-width:420px}
.s6 h1{font-size:clamp(34px,4.5vw,54px);font-weight:600;line-height:1.25;margin-bottom:16px}
.s6 p{color:var(--ink-soft);line-height:1.85;margin-bottom:28px}
.s6 .btn{background:var(--rose-d);color:#fff}

/* ===== 07 glass card ===== */
.s7{padding:0}
.s7 .bg{position:absolute;inset:0}
.s7 .bg svg{width:100%;height:100%}
.s7 .card{position:relative;background:rgba(255,250,243,.55);backdrop-filter:blur(14px);border:1px solid rgba(255,255,255,.65);border-radius:24px;padding:54px 50px;max-width:540px;text-align:center;box-shadow:0 30px 70px -30px rgba(80,50,30,.45)}
.s7 .eyebrow{color:var(--terra-d);margin-bottom:14px}
.s7 h1{font-size:clamp(34px,4.5vw,52px);font-weight:400;margin-bottom:14px}
.s7 p{color:#5C4F43;line-height:1.85;margin-bottom:30px}
.s7 .btn{background:var(--ink);color:#fff}

/* ===== 08 botanical ===== */
.s8{background:#F2F4EE;text-align:center;flex-direction:column}
.s8 .frame{border:1px solid var(--sage);padding:64px 8vw;position:relative;max-width:860px}
.s8 .frame::before{content:"";position:absolute;inset:8px;border:1px solid #C9D2C2;pointer-events:none}
.s8 .leaf{position:absolute;width:90px;opacity:.8}
.s8 .l1{top:-34px;right:-30px}
.s8 .l2{bottom:-34px;left:-30px;transform:rotate(180deg)}
.s8 .eyebrow{color:var(--sage-d);margin-bottom:18px}
.s8 h1{font-size:clamp(34px,5vw,58px);font-weight:300;color:#43503E;margin-bottom:16px}
.s8 p{color:#6C7866;line-height:1.9;max-width:46ch;margin:0 auto 30px}
.s8 .btn{background:var(--sage-d);color:#fff}
.s8 .strip{display:flex;gap:10px;justify-content:center;margin-top:34px}
.s8 .strip div{width:110px;height:74px;border-radius:8px;overflow:hidden}
.s8 .strip svg{width:100%;height:100%}
</style>
</head>

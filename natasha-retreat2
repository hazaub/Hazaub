</nav>

<!-- 01 -->
<section class="slide s1" id="s1">
  <span class="tag">01 · מינימלי מרכזי</span>
  <div>
    <div class="eyebrow">ריטריט נשימה ותנועה · גליל עליון</div>
    <h1 class="serif">מקום שקט<br>לחזור אל עצמך</h1>
    <p>שלושה ימים של יוגה, מדיטציה ושתיקה מיטיבה, בלב טבע פראי ושקט. קבוצה קטנה, אוכל צמחוני חם, ולב פתוח.</p>
    <button class="btn">להרשמה לריטריט</button>
    <div class="arch">
      <svg viewBox="0 0 340 230" preserveAspectRatio="xMidYMid slice"><defs><linearGradient id="g1" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#F6D9B0"/><stop offset=".55" stop-color="#E2A06E"/><stop offset="1" stop-color="#B96E48"/></linearGradient></defs><rect width="340" height="230" fill="url(#g1)"/><circle cx="170" cy="118" r="44" fill="#FFE9C4" opacity=".9"/><path d="M0 170 Q90 120 180 165 T340 150 V230 H0Z" fill="#8C5A3C"/><path d="M0 195 Q110 160 220 195 T340 185 V230 H0Z" fill="#6E4630"/></svg>
    </div>
  </div>
</section>

<!-- 02 -->
<section class="slide s2" id="s2">
  <span class="tag">02 · ספליט קלאסי</span>
  <div class="wrap">
    <div class="txt">
      <div class="eyebrow">12–15 במרץ · רמת הגולן</div>
      <h1>סוף שבוע של נשימה, תנועה ושקט</h1>
      <p>ריטריט אינטימי לעשרים משתתפים בלבד. תרגול בוקר עם זריחה, סדנאות מגע ותנועה, ארוחות מהאדמה, ולילות סביב המדורה. בלי מסכים, בלי רעש — רק אתם והטבע.</p>
      <button class="btn">שריינו מקום</button>
    </div>
    <div class="img">
      <svg viewBox="0 0 600 800" preserveAspectRatio="xMidYMid slice"><defs><linearGradient id="g2" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#CDE3D9"/><stop offset=".6" stop-color="#9DBFA6"/><stop offset="1" stop-color="#5F7059"/></linearGradient></defs><rect width="600" height="800" fill="url(#g2)"/><circle cx="300" cy="250" r="80" fill="#FFF6E0" opacity=".85"/><path d="M0 520 Q150 430 300 500 T600 470 V800 H0Z" fill="#46584A"/><path d="M0 620 Q200 560 400 630 T600 600 V800 H0Z" fill="#33402F"/></svg>
    </div>
  </div>
</section>

<!-- 03 -->
<section class="slide s3" id="s3">
  <span class="tag">03 · חלון קשת</span>
  <div class="archbig">
    <svg viewBox="0 0 520 580" preserveAspectRatio="xMidYMid slice"><defs><linearGradient id="g3" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#FBE3C7"/><stop offset=".5" stop-color="#EBAF7E"/><stop offset="1" stop-color="#A66B49"/></linearGradient></defs><rect width="520" height="580" fill="url(#g3)"/><circle cx="260" cy="220" r="70" fill="#FFF2D6"/><path d="M0 400 Q130 330 260 390 T520 370 V580 H0Z" fill="#7E5037"/><path d="M0 480 Q170 430 340 485 T520 465 V580 H0Z" fill="#5C3A28"/></svg>
    <div class="over">
      <div class="eyebrow" style="letter-spacing:.3em;font-size:12px;margin-bottom:12px">ריטריט מדבר · ניסן תשפ"ו</div>
      <h1 class="serif">לנשום מדבר</h1>
      <p>ארבעה ימים של דממה גדולה</p>
      <button class="btn">לפרטים והרשמה</button>
    </div>
  </div>
</section>

<!-- 04 -->
<section class="slide s4" id="s4">
  <span class="tag">04 · מגזין חופף</span>
  <div class="wrap">
    <div class="photo">
      <svg viewBox="0 0 700 460" preserveAspectRatio="xMidYMid slice"><defs><linearGradient id="g4" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#E9D6C2"/><stop offset="1" stop-color="#C29170"/></linearGradient></defs><rect width="700" height="460" fill="url(#g4)"/><circle cx="500" cy="150" r="56" fill="#FFF3DC"/><path d="M0 300 Q175 230 350 290 T700 270 V460 H0Z" fill="#96664A"/><path d="M0 370 Q230 320 460 375 T700 360 V460 H0Z" fill="#704A35"/></svg>
    </div>
    <h1 class="serif">רגע<br>של <em>שקט</em></h1>
    <div class="meta">
      <p>ריטריט סופ"ש בהרי ירושלים. יוגה, ג'ורנלינג ובישול שורשי. כל החדרים עם נוף ליער.</p>
      <button class="btn">אני רוצה לבוא</button>
    </div>
  </div>
</section>

<!-- 05 -->
<section class="slide s5" id="s5">
  <span class="tag">05 · כהה חם</span>
  <div>
    <div class="sun" style="margin-inline:auto"></div>
    <div class="eyebrow">ריטריט שקיעות · מצפה רמון</div>
    <h1 class="serif">כשהשמש שוקעת,<br>משהו בפנים נרגע</h1>
    <p>ערבי תרגול לאור נרות, מדיטציות שקיעה על שפת המכתש, ושינה עמוקה כמו שלא ישנתם שנים. מחזור קרוב נפתח בקרוב.</p>
    <button class="btn">הצטרפו לרשימת ההמתנה</button>
  </div>
</section>

<!-- 06 -->
<section class="slide s6" id="s6">
  <span class="tag">06 · פולרואיד</span>
  <div class="wrap">
    <div class="pols">
      <div class="pol p1">
        <svg viewBox="0 0 240 200" preserveAspectRatio="xMidYMid slice"><rect width="240" height="200" fill="#DCE8DD"/><circle cx="120" cy="80" r="34" fill="#FFF3D9"/><path d="M0 130 Q60 100 120 125 T240 115 V200 H0Z" fill="#7E9479"/><path d="M0 160 Q80 140 160 162 T240 155 V200 H0Z" fill="#5B6F57"/></svg>
        <span>בוקר ראשון בריטריט</span>
      </div>
      <div class="pol p2">
        <svg viewBox="0 0 240 200" preserveAspectRatio="xMidYMid slice"><rect width="240" height="200" fill="#F4DFC8"/><circle cx="120" cy="70" r="30" fill="#FFEFC9"/><path d="M0 125 Q60 95 120 120 T240 110 V200 H0Z" fill="#C08A5E"/><path d="M0 158 Q80 138 160 160 T240 152 V200 H0Z" fill="#8E6243"/></svg>
        <span>שקיעה מהמרפסת</span>
      </div>
    </div>
    <div class="txt">
      <div class="eyebrow" style="color:var(--rose-d);margin-bottom:14px">זכרונות שנשארים</div>
      <h1 class="serif">החופשה שתזכרו<br>עוד שנים</h1>
      <p>לא עוד חופשה רגילה — אלא שבוע שמשנה את הקצב מבפנים. תרגול, טבע, אנשים טובים, ואוכל שעושה שמח.</p>
      <button class="btn">לתוכנית המלאה</button>
    </div>
  </div>
</section>

<!-- 07 -->
<section class="slide s7" id="s7">
  <span class="tag">07 · כרטיס זכוכית</span>
  <div class="bg">
    <svg viewBox="0 0 1200 800" preserveAspectRatio="xMidYMid slice"><defs><linearGradient id="g7" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#F3D9BC"/><stop offset=".55" stop-color="#E0A87E"/><stop offset="1" stop-color="#9F6B4C"/></linearGradient></defs><rect width="1200" height="800" fill="url(#g7)"/><circle cx="600" cy="280" r="110" fill="#FFF3D9" opacity=".9"/><path d="M0 540 Q300 440 600 520 T1200 490 V800 H0Z" fill="#7E5740"/><path d="M0 650 Q400 580 800 660 T1200 630 V800 H0Z" fill="#5B3D2D"/></svg>
  </div>
  <div class="card">
    <div class="eyebrow">ריטריט קיץ · 20–24 ביולי</div>
    <h1 class="serif">חמישה ימים, אפס דאגות</h1>
    <p>הכול כלול: לינה, אוכל, תרגולים וסדנאות. אתם רק מביאים את עצמכם — אנחנו דואגים לכל השאר.</p>
    <button class="btn">בדקו זמינות</button>
  </div>
</section>

<!-- 08 -->
<section class="slide s8" id="s8">
  <span class="tag">08 · מסגרת בוטנית</span>
  <div class="frame">
    <svg class="leaf l1" viewBox="0 0 90 90"><g fill="none" stroke="#5F7059" stroke-width="2"><path d="M45 85 C45 50 45 25 45 5"/><path d="M45 65 C30 58 20 48 18 35 C32 38 42 48 45 60"/><path d="M45 50 C60 43 70 33 72 20 C58 23 48 33 45 45"/><path d="M45 30 C36 26 30 19 29 11 C38 13 44 19 45 26"/></g></svg>
    <svg class="leaf l2" viewBox="0 0 90 90"><g fill="none" stroke="#5F7059" stroke-width="2"><path d="M45 85 C45 50 45 25 45 5"/><path d="M45 65 C30 58 20 48 18 35 C32 38 42 48 45 60"/><path d="M45 50 C60 43 70 33 72 20 C58 23 48 33 45 45"/><path d="M45 30 C36 26 30 19 29 11 C38 13 44 19 45 26"/></g></svg>
    <div class="eyebrow">ריטריט צמחי מרפא · כרמל</div>
    <h1 class="serif">ללמוד מהצמחים, לרפא מבפנים</h1>
    <p>סיורי ליקוט בוקר, סדנאות חליטות ושמנים, ומעגלי שיח תחת עצי האלון. חוויה עדינה ומחברת לאדמה.</p>
    <button class="btn">למסלול המלא</button>
    <div class="strip">
      <div><svg viewBox="0 0 110 74"><rect width="110" height="74" fill="#C9D8C4"/><path d="M0 48 Q28 36 55 46 T110 42 V74 H0Z" fill="#7E9479"/></svg></div>
      <div><svg viewBox="0 0 110 74"><rect width="110" height="74" fill="#E8DCC6"/><circle cx="55" cy="28" r="14" fill="#FFF2CF"/><path d="M0 50 Q28 40 55 48 T110 44 V74 H0Z" fill="#A78B62"/></svg></div>
      <div><svg viewBox="0 0 110 74"><rect width="110" height="74" fill="#D7E2DC"/><path d="M0 44 Q28 30 55 42 T110 38 V74 H0Z" fill="#5F7059"/></svg></div>
    </div>
  </div>
</section>

<style>
/* ===== 09 circle ===== */
.s9{background:#FBF4EC}
.s9 .wrap{display:flex;align-items:center;gap:6vw;width:min(1060px,94vw);flex-wrap:wrap;justify-content:center}
.s9 .circ{width:min(400px,80vw);aspect-ratio:1;border-radius:50%;overflow:hidden;border:10px solid #fff;box-shadow:0 30px 60px -30px rgba(150,90,50,.45);flex:0 0 auto}
.s9 .circ svg{width:100%;height:100%}
.s9 .txt{max-width:420px}
.s9 h1{font-size:clamp(34px,4.5vw,56px);font-weight:300;line-height:1.25;margin-bottom:16px}
.s9 p{color:var(--ink-soft);line-height:1.9;margin-bottom:30px}
.s9 .btn{background:var(--terra);color:#fff}
.s9 .ring{font-size:13px;letter-spacing:.3em;color:var(--terra-d);margin-bottom:14px}

